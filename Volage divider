# Program 7: Voltage Divider

vin = float(input("Enter input voltage Vin (V): "))
r1 = float(input("Enter R1 (Ohm): "))
r2 = float(input("Enter R2 (Ohm): "))

if r1 + r2 == 0:
    print("Invalid resistance values.")
else:
    vout = vin * r2 / (r1 + r2)

    print("Output voltage Vout =", vout, "V")
